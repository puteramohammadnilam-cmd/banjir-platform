# Copy this file to .env and fill it in. Never commit .env.

# Option A, quickest: free Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option B, on Google Cloud (Vertex AI). Leave GOOGLE_API_KEY empty and set these instead.
# On Cloud Run no key is needed, the service account is used.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-southeast1

# Optional. Defaults to gemini-3.5-flash-lite (a fixed id; check it with the key before a demo: since Oct 2026
# gemini-2.5-flash is refused to new keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Google Maps Platform key for the rain forecast (Weather API) and the open or closed check
# (Places API, New). Enable both APIs on the key and restrict it to those two APIs. It is used by the
# server only and never sent to the browser. Without it the page leaves those two items out.
GOOGLE_MAPS_API_KEY=

# Optional. ArcGIS Location Platform key for the satellite photo on the 3D page (README, "Satellite photo on the 3D
# page"): a Public application key with only the Static basemap tiles privilege, restricted to the site's address.
# The browser gets it (it is in each tile's URL). Without it the 3D page shows the street map.
ARCGIS_API_KEY=

# Optional. Most AI answers a day for the whole site (Malaysia time); past it the assistant asks people to come back
# tomorrow. Defaults to 1500. Set a budget alert and quota in Google Cloud as well.
# AI_DAILY_LIMIT=1500
