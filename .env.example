# Copy this file to .env and fill it in. Never commit .env.

# Option A, quickest: free Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option B, on Google Cloud (Vertex AI). Leave GOOGLE_API_KEY empty and set these instead.
# On Cloud Run no key is needed, the service account is used.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-southeast1

# Optional. Defaults to gemini-3.8-flash (a fixed id; check it with the key before a demo: since Oct 2026
# gemini-2.5-flash is refused to new keys).
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Google Maps Platform key for the rain forecast (Weather API) and the open or closed check
# (Places API, New). Enable both APIs on the key and restrict it to those two APIs. It is used by the
# server only and never sent to the browser. Without it the page leaves those two items out.
GOOGLE_MAPS_API_KEY=
